{
	"name": "@igne-agency/react-native-ui",
	"version": "0.2.0",
	"description": "IGNE's React Native component kit: primitives and the presets over them, form controls in three tiers, a bottom sheet, and DTCG tokens themed through Unistyles.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IGNE-Agency/react-native-ui.git"
	},
	"files": [
		"src",
		"!src/**/*.stories.tsx",
		"!src/lib/forms/story-copy.ts",
		"build",
		"tokens",
		"expo-module.config.json",
		"ios",
		"android",
		"!android/build",
		"!android/.gradle",
		"patches"
	],
	"type": "module",
	"sideEffects": [
		"./src/theme/default.ts"
	],
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"react-native": "./src/index.ts"
		},
		"./theme": {
			"types": "./build/theme/index.d.ts",
			"react-native": "./src/theme/index.ts"
		},
		"./theme/default": {
			"types": "./build/theme/default.d.ts",
			"react-native": "./src/theme/default.ts"
		},
		"./expo-router": {
			"types": "./build/expo-router/index.d.ts",
			"react-native": "./src/expo-router/index.ts"
		},
		"./terrazzo": {
			"types": "./build/terrazzo/index.d.ts",
			"default": "./build/terrazzo/index.js"
		},
		"./tokens/*": "./tokens/*"
	},
	"scripts": {
		"fix": "oxfmt . && oxlint --fix .",
		"check": "oxfmt --check . && oxlint .",
		"tokens": "tz build",
		"build:types": "tsc -p tsconfig.build.json",
		"prepack": "bun run clean && bun run tokens && bun run build:types && bun run build:terrazzo",
		"clean": "rm -rf build",
		"build:terrazzo": "tsc -p tsconfig.terrazzo.json",
		"check:exports": "bun tools/check-exports.ts"
	},
	"dependencies": {
		"@material-design-icons/svg": "^0.14.15",
		"@rn-primitives/checkbox": "^1.5.2",
		"@rn-primitives/progress": "^1.5.2",
		"@rn-primitives/radio-group": "^1.5.2",
		"@rn-primitives/slot": "^1.5.2",
		"@rn-primitives/switch": "^1.5.2",
		"@rn-primitives/tabs": "^1.5.2",
		"@zxcvbn-ts/core": "^4.2.0",
		"@zxcvbn-ts/language-common": "^4.1.3",
		"@zxcvbn-ts/language-en": "^4.1.1",
		"@zxcvbn-ts/language-nl-be": "^4.1.1",
		"culori": "^4.0.2",
		"react-native-otp-entry": "^1.8.6"
	},
	"devDependencies": {
		"@expo/ui": "58.0.26",
		"@gorhom/bottom-sheet": "5.2.14",
		"@react-native/typescript-config": "0.88.1",
		"@storybook/react-native": "10.7.1",
		"@tanstack/react-form": "1.33.5",
		"@terrazzo/cli": "2.10.0",
		"@terrazzo/parser": "2.10.0",
		"@types/bun": "1.4.4",
		"@types/culori": "4.0.1",
		"@types/react": "19.3.0",
		"expo": "58.0.22",
		"expo-blur": "58.0.5",
		"expo-document-picker": "58.0.4",
		"expo-haptics": "58.0.7",
		"expo-image-picker": "58.0.10",
		"expo-router": "58.0.29",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-gesture-handler": "3.3.0",
		"react-native-keyboard-controller": "1.22.7",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "5.10.1",
		"react-native-svg": "15.16.0",
		"react-native-unistyles": "3.8.0",
		"react-native-worklets": "0.13.0",
		"temporal-polyfill": "1.0.6",
		"typescript": "7.0.2",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"@expo/ui": "~58.0.26",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@tanstack/react-form": "^1.33.5",
		"expo": "^58.0.0",
		"expo-blur": "~58.0.5",
		"expo-document-picker": "~58.0.4",
		"expo-haptics": "~58.0.7",
		"expo-image-picker": "~58.0.10",
		"expo-router": "~58.0.29",
		"react": "^19.3.0",
		"react-native": "^0.88.0",
		"react-native-gesture-handler": "^3.3.0",
		"react-native-keyboard-controller": "^1.22.7",
		"react-native-reanimated": "^4.7.1",
		"react-native-safe-area-context": "^5.10.1",
		"react-native-svg": "^15.16.0",
		"react-native-unistyles": "^3.8.0",
		"react-native-worklets": "^0.13.0",
		"temporal-polyfill": "^1.0.6"
	},
	"peerDependenciesMeta": {
		"expo-router": {
			"optional": true
		}
	},
	"patchedDependencies": {
		"@gorhom/bottom-sheet@5.2.14": "patches/@gorhom%2Fbottom-sheet@5.2.14.patch"
	}
}
